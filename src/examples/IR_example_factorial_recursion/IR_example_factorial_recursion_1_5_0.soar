?lang=soar_IR
?langver=1.4.0

init

label result

stlcsz a 4
set b 4

call 2 @_factorial

putsz result 4

func @_factorial
    ifeql _arg0 1
        setsz [_rtaddr] 4 1
        ret
        breakfn
    end
    
    pushsz 4 _arg0
    stlcsz a 4
    set b _arg0
    dec b
    
    call 2 @_factorial

    bytecpy [sp]-8 a 4
    bytecpy [sp]-4 b 4
    mul a b
    setsz [_rtaddr] 4 a
    ret
endfunc