?lang=soar_IR
?langver=1.1.0

init

stlc a
set f a 
set b 4

call 2 @_factorial

put [f]

func @_factorial
    ifeql [fp+16] 1
        set [[fp]+8] 1
        ret
        breakfn
    end
    
    push [fp+16]
    stlc a 
    set b [fp+16]
    dec b
    
    call 2 @_factorial

    mul [sp]-16 [sp-8]
    set [[fp]+8] [sp-16]
    ret
endfunc