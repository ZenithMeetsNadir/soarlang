?lang=soar_IR
?langver=1.0.0

init

set a sp
set f a
resrv
set b 4

call 2 @_factorial

testeql [f] 24
put [f]

func @_factorial
    set a fp
    incws a
    set b a
    incws b

    ifeql [b] 1
        deref a
        set [a] [b]
        ret
    end
    else
        set a sp
        resrv
        deref b
        dec b

        call 2 @_factorial

        set a sp
        decws a

        set b fp
        add b 16
        deref b

        mul b [a]

        set a fp
        incws a
        deref a
        set [a] b

        ret
    end
endfunc