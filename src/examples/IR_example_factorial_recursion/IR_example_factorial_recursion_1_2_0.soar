?lang=soar_IR
?langver=1.2.0

init

stlc a
set f a 
set b 4

call 2 @_factorial

put [f]

func @_factorial
    ifeql _arg 1
        set [_rtaddr] 1
        ret
        breakfn
    end
    
    push _arg
    stlc a 
    set b _arg
    dec b
    
    call 2 @_factorial

    mul [sp]-16 [sp-8]
    set [_rtaddr] [sp-16]
    ret
endfunc