?lang=soar_IR
?langver=0.7.0

init

label result
stlcsz a 4

set b 4

call 2 @_factorial

put%4 result

func @_factorial
    ifeql _arg1 1
        set%4 [_rtaddr] 1
        ret
        breakfn
    end
    
    push%4 _arg1
    stlcsz a 4
    set b _arg1
    dec b
    
    call 2 @_factorial

    mul%4 [sp]-8 [sp-4]
    set%4 [_rtaddr] [sp-8]
    ret
endfunc